{
  "name": "PureTickets",
  "version": "1.0.0",
  "main": "src/server.ts",
  "author": "broccolai",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "$npm_execpath run lint && $npm_execpath run build && node ./dist/server.js",
    "lint": "eslint \"src/**\" --fix",
    "dev": "tsc-watch --onSuccess \"node ./dist/server.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "module-alias": "^2.2.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "22.0.2",
    "@types/sqlite3": "^3.1.11",
    "eslint": "9.8.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "prettier": "3.3.3",
    "ts-node": "10.9.2",
    "tsc-watch": "^6.2.0",
    "typescript": "5.5.4"
  },
  "_moduleAliases": {
    "@api": "dist/api",
    "@lib": "dist/lib",
    "@constructs": "dist/constructs"
  }
}
